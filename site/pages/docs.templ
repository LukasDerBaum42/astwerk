package pages

import (
	"github.com/LukasDerBaum42/astwerk/site/templates"
	"github.com/LukasDerBaum42/astwerk/ssg"
)

// DocPage renders one documentation page.
//
// body is HTML that goldmark already produced from markdown, so it goes through
// templ.Raw rather than being escaped.
templ DocPage(c ssg.Ctx, sidebar []templates.NavItem, description string, body string, prev, next *templates.NavItem) {
	@templates.Layout(c, sidebar) {
		<article class="prose">
			<h1>{ c.Title }</h1>
			if description != "" {
				<p class="lede">{ description }</p>
			}
			@templ.Raw(body)
		</article>
		<nav class="pager">
			if prev != nil {
				<a class="prev" href={ c.Link(prev.Path) }>
					<span>Previous</span>{ prev.Label }
				</a>
			}
			if next != nil {
				<a class="next" href={ c.Link(next.Path) }>
					<span>Next</span>{ next.Label }
				</a>
			}
		</nav>
	}
}

// DocsIndex lists every documentation page with its summary.
templ DocsIndex(c ssg.Ctx, sidebar []templates.NavItem, entries []DocSummary) {
	@templates.Layout(c, sidebar) {
		<article class="prose">
			<h1>Documentation</h1>
			<p class="lede">
				Start with Getting started, then read The Node tree — between them they
				cover everything needed to generate a site. The rest is optional.
			</p>
			<dl class="doc-list">
				for _, e := range entries {
					<dt><a href={ c.Link(e.Path) }>{ e.Title }</a></dt>
					<dd>{ e.Description }</dd>
				}
			</dl>
		</article>
	}
}

// DocSummary is one entry in the docs index.
type DocSummary struct {
	Title       string
	Description string
	Path        string
}

templ NotFound(c ssg.Ctx) {
	@templates.Layout(c, nil) {
		<article class="prose">
			<h1>404</h1>
			<p>That page doesn't exist.</p>
			<p><a href={ c.Link("") }>Back to the home page</a></p>
		</article>
	}
}
