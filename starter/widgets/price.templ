package widgets

import x "github.com/LukasDerBaum42/astwerk/x"

// Price and Qty are two-way bound number inputs; Total is derived from them.
var Price = x.NewNumSignal(10.0)
var Qty = x.NewNumSignal(2.0)
var Total = x.Computed(x.Mul(Price, Qty))

// PriceForm shows a computed value over two two-way inputs: editing either
// field recomputes the total in the browser, and setting a field from code
// would update it in turn.
templ PriceForm() {
	<div class="price">
		@Price.Number()
		@Qty.Number()
		<span>total: </span>
		@Total
	</div>
}
