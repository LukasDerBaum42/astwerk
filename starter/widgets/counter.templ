package widgets

import x "github.com/LukasDerBaum42/astwerk/x"

// Count is a live counter. It is named so hand-written scripts (see
// TitleEffect) can read it. Package-level state is shared by every page that
// renders the widget.
var Count = x.Named("count", 0)

// Revealed drives the conditional section below, toggled by the button.
var Revealed = x.NewSignal(false)

// Counter renders a counter with increment and reset buttons. Wrap the page
// content in x.Document (see pages/reactive.templ) to make it live; rendered
// without one it stays static.
templ Counter() {
	<div class="counter">
		@x.Text(Count)
		@x.El("button", x.On("click", Count.Set(Count.Add(1)))) {
			+
		}
		@x.El("button", x.On("click", Count.Set(x.Lit(0)))) {
			reset
		}
	</div>
}

// Reveal toggles a conditional subtree: the body is unmounted from the DOM
// while hidden, and rebuilt fresh on every reveal — unlike Show, which only
// toggles visibility and keeps state.
templ Reveal() {
	@x.El("button", x.On("click", Revealed.Set(x.Not(Revealed)))) {
		toggle
	}
	@x.When(Revealed, revealBody())
}

// revealBody must stay static: markers inside a When subtree render their
// static form and are not re-wired when it remounts.
templ revealBody() {
	<p>secret</p>
}

// TitleEffect keeps the document title in sync with Count — a live effect in a
// <script>, reading the signal by name. Render it inside the same x.Document
// as Counter.
templ TitleEffect() {
	@x.Effect() {
		<script>
			document.title = "Count: " + count.get();
		</script>
	}
}
