package widgets

import x "github.com/LukasDerBaum42/astwerk/x"

// Todo is one list item. The json tags are the field names the keyed list
// reads at runtime, so they are part of the contract between the Go struct
// and todoRow below.
type Todo struct {
	ID   string `json:"id"`
	Text string `json:"text"`
}

// Todos is the list itself; Draft is the new-item input. Both are named so the
// scripts in todoScripts can read them.
var Todos = x.Named("todos", []Todo{})
var Draft = x.Named("draft", "")

// TodoList renders the input, the add button and the keyed list. Items present
// at build time render through todoRow; items added in the browser render
// through the todoRow script in todoScripts.
templ TodoList() {
	<div class="todo">
		@x.Input(Draft)
		<button id="add-todo">Add</button>
		@x.List(Todos, "id", todoRow, "todoRow")
	</div>
	@todoScripts()
}

// todoRow renders an item present at build time — the static half.
templ todoRow(item Todo) {
	<li>{ item.Text }</li>
}

// todoScripts renders the client-side half: the row template for items added
// at runtime, and the add handler. This is the escape hatch — anything a
// combinator cannot say is a script, and scripts read the named signals above
// directly. The script sits after the markup it wires, so the button exists by
// the time it runs.
templ todoScripts() {
	<script>
		const esc = (s) => String(s).replace(/[&<>"]/g, (c) => "&#" + c.charCodeAt(0) + ";");
		function todoRow(item) {
			return `<li>${esc(item.text)}</li>`;
		}
		document.querySelector("#add-todo").addEventListener("click", () => {
			const text = draft.get();
			if (!text) return;
			todos.set([...todos.get(), { id: String(Date.now()), text }]);
			draft.set("");
		});
	</script>
}
