package pages

import (
	"example.com/yoursite/layout"
	"example.com/yoursite/widgets"
	x "github.com/LukasDerBaum42/astwerk/x"
)

// Reactive is a page built from the x widgets. The widget area is wrapped in
// x.Document, which emits the runtime and state declarations before it and the
// bindings after it; the page around it is ordinary templ. Wire it up as
//
//	"reactive": {Title: "Reactive", Page: ssg.Templ(pages.Reactive)},
//
// Every widget above renders its current value statically, so the page reads
// fine with JavaScript disabled — Document only adds behaviour.
templ Reactive(title string, path string, prefix string) {
	@layout.BaseLayout(title, path, prefix) {
		<h1>{ title }</h1>
		@x.Document(widgetsPage())
	}
}

templ widgetsPage() {
	@widgets.Counter()
	@widgets.TitleEffect()
	@widgets.Reveal()
	@widgets.PriceForm()
	@widgets.TodoList()
}
