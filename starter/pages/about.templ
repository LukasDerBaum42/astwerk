package pages

import "example.com/yoursite/layout"

// About is a plain one-off page that needs no collection behind it.
templ About(title string, path string, prefix string) {
	@layout.BaseLayout(title, path, prefix) {
		<h1>{ title }</h1>
		<p>A couple of paragraphs about yourself.</p>
	}
}
