package content

import (
	"example.com/yoursite/layout"
	"github.com/a-h/templ"
)

// Tile is one card in a collection index. The href is just the slug, so it
// resolves relative to the index page and stays correct inside a locale
// subtree without any prefix threading.
templ Tile(it Item) {
	<a class="tile" href={ it.Slug + "/" }>
		<h2>{ it.Title }</h2>
		if it.Description != "" {
			<p>{ it.Description }</p>
		}
		if len(it.Tags) > 0 {
			@TagList(it.Tags)
		}
	</a>
}

// CollectionItem is the detail page for one entry.
//
// body is the component returned by content.Item.Content(c); pass the page's
// ctx so markdown components run and relative URLs resolve correctly.
//
//	out[slug] = ssg.Node{Title: fm.Title, Page: func(c ssg.Ctx) templ.Component {
//		return content.CollectionItem(c.Title, c.Path, c.Prefix, p.Content(c), fm.Tags)
//	}}
templ CollectionItem(title string, path string, prefix string, body templ.Component, tags []string) {
	@layout.BaseLayout(title, path, prefix) {
		<article class="prose">
			<h1>{ title }</h1>
			if len(tags) > 0 {
				@TagList(tags)
			}
			@body
		</article>
	}
}
